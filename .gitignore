# The notebook regenerates everything below from scratch, so none of it is tracked.
# The directories themselves ARE tracked (via .gitkeep): cell A1 locates the repo root by
# testing for `outputs/`, so that directory must exist in a fresh clone.

# AequilibraE project: SQLite databases, OSM extract, parameters, logs
data/*
!data/.gitkeep

# Interactive HTML maps written by the notebook (9-19 MB each)
outputs/*
!outputs/.gitkeep

# The exception: the notebook's exported results ARE tracked. A clone has no data/gov_data/, so
# it cannot regenerate them, and the SQLite project they come from holds no results at all.
!outputs/taz_od_exports/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
